# ── Database ──────────────────────────────────────────────────────────────────
# Neon (https://neon.tech) free tier works fine
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256

# ── LLM APIs ──────────────────────────────────────────────────────────────────
# Required for resume tailoring (Tool 1 keyword extract + Tool 3 evaluation)
OPENAI_API_KEY=sk-...

# Required for resume tailoring (Tool 2 — main rewrite)
CLAUDE_API_KEY=sk-ant-...

# Optional — fallback LLM for SmartExtract (Phase C)
GEMINI_API_KEY=AIza...
GOOGLE_API_KEY=AIza...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dev: Vite default port
CORS_ORIGINS=http://localhost:5173

# ── Dev ───────────────────────────────────────────────────────────────────────
# Shows full tracebacks in 500 responses — set to false in production
DEBUG=true

# ── File uploads ──────────────────────────────────────────────────────────────
# Directory for uploaded resumes (relative to JOBEZEE/)
UPLOAD_DIR=uploads
