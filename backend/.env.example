# ── Copy this to .env and fill in your values ─────────────────────────────────

# Neon PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# JWT — change to a secure random 32+ char string in production
JWT_SECRET=changeme-use-a-32-char-random-string-in-prod
JWT_ALGORITHM=HS256

# Tavily — AI web search (job discovery in production)
# Get key at: https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM keys for resume tailoring + status detection
OPENAI_API_KEY=sk-proj-xxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GOOGLE_API_KEY=

# Gmail IMAP (email scan for application status updates)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_RENDER_APP.onrender.com/api/auth/linkedin/callback

# CORS / Frontend URL (set to your Vercel URL in production)
FRONTEND_URL=https://YOUR_APP.vercel.app
CORS_ORIGINS=https://YOUR_APP.vercel.app,http://localhost:5173

# App
UPLOAD_DIR=uploads
DEBUG=false
