# ── Copy this to .env and fill in your values ─────────────────────────────────

# Neon PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# JWT — change to a secure random 32+ char string in production
JWT_SECRET=changeme-use-a-32-char-random-string-in-prod
JWT_ALGORITHM=HS256

# Tavily — AI web search (job discovery in production)
# Get key at: https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM keys for resume tailoring + status detection
OPENAI_API_KEY=sk-proj-xxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GOOGLE_API_KEY=

# Gmail IMAP (email scan for application status updates)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP — transactional email (forgot-password, etc.)
# Option A — Gmail App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app-password>
# Option B — SendGrid:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=SG.xxxxxxxx
# Option C — Resend (recommended for production):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=re_xxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=noreply@jobezee.org

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_RENDER_APP.onrender.com/api/auth/linkedin/callback

# CORS / Frontend URL (set to your Vercel URL in production)
FRONTEND_URL=https://www.jobezee.org
CORS_ORIGINS=https://www.jobezee.org,https://jobezee.org,http://localhost:5173

# Cookie domain — set this once you add api.jobezee.org as custom domain in Render
# This makes cookies first-party (works in ALL browsers including Safari)
# Leave blank if backend is still on onrender.com
COOKIE_DOMAIN=.jobezee.org

# App
UPLOAD_DIR=uploads
DEBUG=false
