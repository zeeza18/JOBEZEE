{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://5.161.60.37:8000/api/$1",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
    },
    {
      "src": "/uploads/(.*)",
      "dest": "http://5.161.60.37:8000/uploads/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
